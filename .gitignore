# entorno
.env
__pycache__/
*.pyc
.venv

# airflow runtime
logs/*
!logs/.gitkeep
plugins/*
!plugins/.gitkeep

# datos (capa bronce y plata no se versionan, pesan y no son código)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# docker-compose.yaml oficial de Airflow: se descarga en cada máquina (Fase 0), no se versiona
docker-compose.yaml

# airflow.cfg generado por el contenedor: es propio de cada maquina
config/

# guiones de exposicion: material interno de ensayo (reparto, quien dice
# que), quedan en local en vez del repo
Documentacion/Entrega_*_Plan.md
